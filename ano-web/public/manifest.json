{
  "manifest_version": 3,
  "name": "Ano-Web",
  "version": "1.0",
  "description": "AIを活用した「ふわっと検索」履歴アプリ",
  "permissions": [
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "memory.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "history": "index.html"
  },
  "action": {
    "default_title": "Ano-Webを開く"
  },
  "commands": {
    "open-search-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Ano-Web 検索画面を開く"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}